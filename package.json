{
    "name": "fintrack-api",
    "version": "1.0.0",
    "description": "FinTrack personal finance API — Transaction module + Expense Splitting feature",
    "main": "dist/server.js",
    "scripts": {
        "build": "tsc",
        "start": "node dist/server.js",
        "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
        "test": "jest --runInBand",
        "test:coverage": "jest --coverage --runInBand",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev --name init",
        "prisma:seed": "ts-node-dev --transpile-only prisma/seed.ts",
        "lint": "eslint . --ext .ts"
    },
    "keywords": [
        "fintech",
        "expense-splitting",
        "api"
    ],
    "author": "FinTrack Engineering",
    "license": "UNLICENSED",
    "dependencies": {
        "@prisma/client": "^5.18.0",
        "express": "^4.19.2",
        "winston": "^3.14.2",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/jest": "^29.5.12",
        "@types/node": "^20.14.15",
        "@types/supertest": "^6.0.2",
        "jest": "^29.7.0",
        "prisma": "^5.18.0",
        "supertest": "^7.0.0",
        "ts-jest": "^29.2.4",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.5.4"
    }
}